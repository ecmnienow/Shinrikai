# Copie para .env (ignorado pelo git) e troque os valores antes do "docker compose up".
# Senhas sem ";" (a do FIREBIRD_PASSWORD vai dentro da connection string).

# Senha do SYSDBA dentro do container.
FIREBIRD_ROOT_PASSWORD=troque-esta-senha-do-sysdba
# Senha do usuário "shinrikai", que a API usa.
FIREBIRD_PASSWORD=troque-esta-senha-da-aplicacao
# Porta da interface no Windows (opcional, padrão 8090).
# WEB_PORT=8090
# Chave HMAC do JWT, com pelo menos 32 bytes. Para gerar uma no PowerShell:
#   $b = New-Object byte[] 48; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
JWT_KEY=troque-por-uma-chave-aleatoria-com-pelo-menos-32-bytes
