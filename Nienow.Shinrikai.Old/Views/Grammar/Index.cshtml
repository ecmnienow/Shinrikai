@model List<List<Nienow.Shinrikai.Grammar.Model.GGrammar>>
@{
    ViewBag.Title = "Estudo de gramática";

    bool admOrTeacher = User.IsInRole("Administrator") || User.IsInRole("Teacher");
}

<script type="text/javascript">
    var _url_DeclareKnowledge = "@Url.Action("DeclareKnowledge", "Grammar")";
    var _url_Exercises = "@Url.Action("Index", "Exercises")";
    var _url_GetGrammar = "@Url.Action("GetGrammar", "Grammar")";
    var _url_GetRequisites = "@Url.Action("GetRequisites", "Grammar")";
    var _url_RegisterGrammar = "@Url.Action("Register", "Grammar")";
</script>

<script type="text/javascript">
    var timeOutEvent;

    $(function () {
        NotificationDialog(3);
    });

    function DeclareKnowledge(id) {
        $.ajax({
            type: "POST",
            url: _url_DeclareKnowledge,
            data: {
                id: id
            }
        });
    }

    function DoExercises() {
        var textId = $("#idExercise li").attr("data-id");
        window.location = _url_Exercises + "?grammarId=" + textId;
    }

    function EditGrammar(id) {
        window.location = _url_RegisterGrammar + "?id=" + id;
    }

    function LoadGrammar(el, id) {
        if (el.hasClass("disabled")) {
            ShowRequisites(id);
            return;
        }
        
        if (el.data("exercises") === true) {
            $("#idExercise").show();
            $("#idExercise li").attr("data-id", id);
        }
        else
            $("#idExercise").hide();

        $(".grammars .active").removeClass("active");
        el.addClass("active");
        
        $.ajax({
            type: "POST",
            url: _url_GetGrammar,
            dataType: "json",
            data: {
                id: id
            }
        })
        .done(function (data) {
            $(".grammar h2").html(data.Title);
            $("#grammarContent").html(data.Body);

            TriggerTimeOut(id);
        });
    }
    
    function Next() {
        if ($(".grammars .list-group-item.active").length == 0)
            return false;

        var next = $(".grammars .list-group-item.active").next();
        while (true) {
            if (!next || typeof next === "undefined" || !next.data("id"))
                return false;

            if (next.hasClass("disabled"))
                next = next.next();
            else {
                LoadGrammar(next, next.data("id"));
                return false;
            }
        }
    }

    function Previous() {
        if ($(".grammars .list-group-item.active").length == 0)
            return false;

        var previous = $(".grammars .list-group-item.active").prev();
        while (true) {
            if (!previous || typeof previous === "undefined" || !previous.data("id"))
                return false;

            if (previous.hasClass("disabled"))
                previous = previous.prev();
            else {
                LoadGrammar(previous, previous.data("id"));
                return false;
            }
        }
    }

    function ShowRequisites(id) {
        $.ajax({
            type: "POST",
            url: _url_GetRequisites,
            dataType: "html",
            data: {
                id: id
            }
        })
        .done(function (data) {
            AlertDialog(data);
        });
    }

    function TriggerTimeOut(id)
    {
        if (timeOutEvent)
            clearTimeout(timeOutEvent);

        timeOutEvent = setTimeout(function () {
            console.log("Knowledge declared.");
            DeclareKnowledge(id);
        }, 20000);
    }
</script>

<style type="text/css">
    .grammar {
        margin-bottom: 80px;
    }

        .grammars > li > span {
            overflow-x: hidden;
            text-overflow: ellipsis;
            display: inline-block;
            vertical-align: middle;
            @if(admOrTeacher) { <text> width: calc(100% - 14px); </text> }
            else{ <text> width: 100%; </text> }
        }

        .grammars > li > i {
            vertical-align: middle;
        }

    #grammarContent {
        font-size: 1.15em;
    }

    .glyphicon-edit:hover {
        box-shadow: 0 0 10px gray;
    }

    .active .glyphicon-edit:hover {
        box-shadow: 0 0 10px white;
    }

    .help {
        cursor: pointer;
    }

    .navigation {
        text-align: center;
        width: 180px;
        display: inline-block;
        position: fixed;
        right: 0;
        left: 0;
        margin-right: auto;
        margin-left: auto;
        bottom: 25px;
    }

        .navigation button {
            box-shadow: 0 0 15px lightgray;
        }

    .panel {
        box-shadow: none !important;
        background-color: #FFF !important;
        margin-bottom: 20px !important;
        border: none !important;
        border-radius: 0 !important;
    }

        .panel ul {
            max-height: 200px;
            overflow: hidden;
        }

         .panel ul.in {
            overflow: auto;
         }

    #idExercise {
        margin-top: 20px;
    }
</style>

<div class="grammar container">
    <div id="menu" class="col-sm-2">
        <div class="panel list-group navbar">
            @foreach (var grp in Model)
            {
                var jlpt = grp.FirstOrDefault().Grammar.Level.ToString();
                <a href="#" class="list-group-item btn-default" data-parent="#menu" data-toggle="collapse" data-target="#@jlpt" style="text-align: center;">
                    <strong>@jlpt</strong>
                </a>
                <ul id="@jlpt" class="grammars list-group collapse">
                    @foreach (var gra in grp)
                    {
                        <li class="list-group-item btn @(gra.HasEnoughLevel ? "" : "disabled")" data-id="@gra.Grammar.Index" data-exercises="@gra.HasExercises.ToString().ToLower()" onclick="LoadGrammar($(this), @gra.Grammar.Index)">
                            <span>@gra.Grammar.Title</span><!--
                            -->@if (admOrTeacher){<i class="glyphicon glyphicon-edit" onclick="EditGrammar(@gra.Grammar.Index); return false;"></i>}
                        </li>
                    }
                </ul>
            }
        
            <ul id="idExercise" class="list-group nav-stacked" style="display: none;">
                <li class="list-group-item btn bottom list-group-item-info" onclick="DoExercises()">
                    <span>Exercícios</span>
                </li>
            </ul>
        </div>
    </div>

    <div class="col-sm-10">
        <i class="help glyphicon glyphicon-question-sign pull-right" onclick="NotificationDialog(3, true);"></i>
        <h2 class="center">Estudo de Gramática</h2>
        <div id="grammarContent">
            <!--Apresentação inicial-->
            Selecione um dos conteúdos listados para começar.
        </div>
    </div>
</div>

<div class="panel-default navigation">
    <div>
        <button type="button" class="btn btn-default" onclick="Previous()">Anterior</button>
        <button type="button" class="btn btn-default" onclick="Next()">Próximo</button>
    </div>
</div>
