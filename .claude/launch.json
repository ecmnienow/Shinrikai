{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "shinrikai-api",
      "runtimeExecutable": "dotnet",
      "runtimeArgs": ["run", "--project", "Nienow.Shinrikai.Api", "--launch-profile", "Shinrikai"],
      "port": 5080
    },
    {
      "name": "shinrikai-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "Nienow.Shinrikai.Web/ClientApp", "run", "dev"],
      "port": 5173
    },
    {
      "name": "shinrikai-web-host",
      "runtimeExecutable": "dotnet",
      "runtimeArgs": ["run", "--project", "Nienow.Shinrikai.Web", "--launch-profile", "Shinrikai"],
      "port": 5090
    }
  ]
}
