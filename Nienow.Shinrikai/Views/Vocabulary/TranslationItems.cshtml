@model List<Nienow.Shinrikai.Vocabulary.Model.GWordAnswer>
@{
    Layout = null;
}

@foreach(var word in Model)
{
    <div class="row @(word.Wrong ? "has-error" : "")">
        <div class="col-sm-2 control-label"><label>@word.Word</label></div>
        <div class="col-sm-10"><input class="form-control" type="text" value="@word.Answer" /></div>
    </div>
}