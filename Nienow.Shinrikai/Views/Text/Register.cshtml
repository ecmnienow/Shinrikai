@using Nienow.Shinrikai.Core
@model Nienow.Shinrikai.Text.Model.TText
@{
    ViewBag.Title = "Cadastro de Textos";
}

@section scripts {
    <script type="text/javascript" src="../../Scripts/ckeditor/ckeditor.js"></script>

    <script type="text/javascript">
        var _url_AddText = "@Url.Action("AddText", "Text")";
        var _url_RegisterExercises = "@Url.Action("Register", "Exercises")";
        var _textId = @Model.Index;
    </script>

    <script type="text/javascript">
        $(function () {
            window.spellcheck = 'false';
            CKEDITOR.replace('editor', {
                disableNativeSpellChecker: true,
                resize_enabled: false,
            });

            // wait until the editor has done initializing
            CKEDITOR.on("instanceReady", function () {
                FixCKEditorPosition();
            });

            @if(Model.Index != 0)
            {
                <text>
                var text = "@Html.Raw(Model.Body.Replace(Environment.NewLine, "").Replace("\n", "").Replace("\"", "\\\""))";
                CKEDITOR.instances['editor'].setData(text);
                </text>
            }
        });
        
        function AddExercise() {
            if(_textId == 0)
                AlertDialog("Antes de adicionar um exercício ao conteúdo gramatical, este deve já estar cadastrado.", null);
            else
                window.location = _url_RegisterExercises + "?textId=" + _textId;
        }
        
        function Cancel() {
            window.location = window._url_Home;
        }

        function FixCKEditorPosition() {
            $("#cke_1_contents").css('height',
                (($("#cke_1_contents").parent().parent().outerHeight() - $("#cke_1_top").outerHeight()) - 2) + 'px');
        }

        function Register() {
            if (!Validate())
                return;

            var title = $("#txtTitle").val();
            var level = $(".radio input[type='radio']:checked").val();
            var body = CKEDITOR.instances['editor'].getData();
            var textId = @Model.Index;

            $.ajax({
                type: "POST",
                url: _url_AddText,
                data: {
                    id: textId,
                    title: title,
                    level: level,
                    body: body
                }
            })
            .done(function (data) {
                if (data == true) {
                    if(textId == 0) {
                        InformationDialog("Texto cadastrado com sucesso!", null, function () {
                            location.reload();
                        });
                    }
                    else {
                        InformationDialog("Texto alterado com sucesso!", null, function () {
                            if("@Request.UrlReferrer")
                                window.location = "@Request.UrlReferrer";
                            else
                                window.location = window._url_Home; 
                        });
                    }
                }
                else
                    if(textId == 0)
                        ErrorDialog("Não foi possível cadastrar o novo texto!");
                    else
                        ErrorDialog("Não foi possível alterar o texto!");
            });
        }

        function Validate() {
            var title = $("#txtTitle").val();
            if (!title || title.length == 0) {
                AlertDialog("É obrigatório que informe um título para o texto a ser cadastrado.");
                return false;
            }

            var body = CKEDITOR.instances['editor'].getData();
            if (!body || body.length == 0) {
                AlertDialog("O texto a ser cadastrado não possui um corpo.");
                return false;
            }

            return true;
        }
    </script>

    <style type="text/css">
        .reading {
            margin-bottom: 50px;
        }

            .reading #cke_editor {
                height: 400px;
            }

            .reading .labelName {
                display: inline-block;
            }
            .reading .labelName:first-child {
                margin-right: 15px;
            }

            .reading .labelName:not(:first-child) {
                width: calc(100% - 58px);
            }

                .reading .labelName > input {
                    width: 100%;
                }

            .reading .requiredLevel {
                display: inline-block;
                margin-right: 15px;
            }

                .reading .requiredLevel > label {
                    margin-right: 10px;
                }
    </style>
}

<div class="reading container">
    <h2 class="center">Cadastro de Textos</h2>

    <div>
        <label class="labelName">Título</label>
        <div class="labelName form-horizontal center">
            <input id="txtTitle" type="text" value="@(Model.Index == 0 ? "" : Model.Title)" />
        </div>
    </div>
    
    <div>
        <label class="requiredLevel">Nível aconselhado</label>
        <div class="requiredLevel form-horizontal center radio">
            <label><input type="radio" name="optionsRadios" id="rbtNone" value="none" @(Model.Level == EJLPT.None ? "checked='checked'" : "")>Nenhum</label>
            <label><input type="radio" name="optionsRadios" id="rbtN5" value="n5" @(Model.Level == EJLPT.N5 ? "checked='checked'" : "")>N5</label>
            <label><input type="radio" name="optionsRadios" id="rbtN4" value="n4" @(Model.Level == EJLPT.N4 ? "checked='checked'" : "")>N4</label>
            <label><input type="radio" name="optionsRadios" id="rbtN3" value="n3" @(Model.Level == EJLPT.N3 ? "checked='checked'" : "")>N3</label>
            <label><input type="radio" name="optionsRadios" id="rbtN2" value="n2" @(Model.Level == EJLPT.N2 ? "checked='checked'" : "")>N2</label>
            <label><input type="radio" name="optionsRadios" id="rbtN1" value="n1" @(Model.Level == EJLPT.N1 ? "checked='checked'" : "")>N1</label>
        </div>
    </div>

    <div id="editor"></div>

    <form class="form-horizontal center" role="form" style="margin-top: 15px;">
        <div class="row" style="text-align: right; margin-right: 0; margin-left: 0;">
            <div class="clearfix">
                <div class="pull-left">
                    <button type="button" class="btn btn-primary" onclick="Register()">@(Model.Index == 0 ? "Cadastrar" : "Alterar")</button>
                    <button type="button" class="btn btn-default" onclick="Cancel()">Cancelar</button>
                </div>
                <button type="button" class="btn btn-primary" onclick="AddExercise()">Adicionar exercício</button>
            </div>
        </div>
    </form>
</div>
