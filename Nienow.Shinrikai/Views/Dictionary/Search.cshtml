@model Nienow.Shinrikai.Dictionary.Models.GResult
@{
    Layout = null;

    bool admOrTeacher = User.IsInRole("Administrator") || User.IsInRole("Teacher");
}

@if(Model.Results.Count > 0)
{
    <h4>Resultados para "@Model.Term"</h4>

    <div>
        @foreach (var result in Model.Results)
        {
            <div class="row">
                <label class="col-sm-2 control-label text-right">@Html.Raw(result.FoundTerm.Replace(Model.Term, "<span class=\"highlight\">" + Model.Term + "</span>"))</label>
                <div class="col-sm-10">
                    <div style="margin-right: 10px; display: inline-block">
                        @if(admOrTeacher){<i class="glyphicon glyphicon-edit" onclick="EditWord(@result.Word.ID)" title="Editar"></i>}
                        @if(result.Word.HasImage1 || result.Word.HasImage2 || result.Word.HasImage3)
                        {
                            <span class="image" onclick="ShowImage('@(Url.Action("GetImage", "Dictionary") + "?imageId=" + result.Word.ID + "&time=" + DateTime.Now.Ticks)');">
                                <i class="glyphicon glyphicon-picture" title="Ver imagem"></i>
                            </span>
                        }
                        @if(result.Word.HasAudio1 || result.Word.HasAudio2 || result.Word.HasAudio3)
                        {
                            <span class="audio" onclick="PlayAUdio('@(Url.Action("GetAudio", "Dictionary") + "?audioId=" + result.Word.ID + "&time=" + DateTime.Now.Ticks)');">
                                <i class="glyphicon glyphicon-play-circle" title="Tocar áudio"></i>
                            </span>
                        }
                    </div>
                    @if (!string.IsNullOrEmpty(result.Word.KanjiWord1))
                    {
                        <span style="white-space: pre;">@result.Word.Kana  [ @string.Join(", ", result.Word.GetAllKanjiWords()) ]</span>
                    }
                    else
                    {
                        <span>@result.Word.Kana</span>
                    }
                </div>
                <div class="col-sm-2"></div>
                <div class="col-sm-10"><label>@string.Join(", ", result.Word.GetAllTranslatedWords(null))</label></div>
            </div>
            <br />
        }
    </div>
}
else
{
    <h4>Nenhum resultado para "@Model.Term"</h4>
}