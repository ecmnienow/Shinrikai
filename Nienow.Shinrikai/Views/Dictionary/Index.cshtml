@{
    ViewBag.Title = "Dicionário";
}

<script type="text/javascript" src="../../Scripts/bootstrap.image/viewer.js"></script>

<script type="text/javascript">
    var _url_RegisterWord = "@Url.Action("Register", "Vocabulary")";
    var _url_Search = "@Url.Action("Search", "Dictionary")";
</script>

<script type="text/javascript">
    $(function() {
        $("#txtSearch").keydown(function(e) {
            if (e.which == 13 || e.keyCode == 13)
                Search();
        });
    });

    function EditWord(id) {
        window.location = _url_RegisterWord + "?id=" + id;
    }

    function PlayAUdio(url) {
        var html = '<audio id="player">';
        html += '    <source src="' + url + '" type="audio/mpeg">';
        html += '    Your browser does not support the audio element.';
        html += '</audio>';

        $("#audioContainer").html(html);
        
        var player = document.getElementById('player');
        player.play();
    }

    function Search() {
        if (!$("#txtSearch").val() || $("#txtSearch").val().length == 0) {
            $("#txtSearch").parent().addClass("has-error");
            return;
        }
        else
            $("#txtSearch").parent().removeClass("has-error");

        $.ajax({
            type: "POST",
            dataType: "html",
            url: _url_Search,
            data: {
                search: $("#txtSearch").val(),
                type: $("#rbtOptions input[type='radio']:checked").val()
            },
        })
        .done(function (data) {
            $("#txtResponse").html(data);
        });
    }
</script>

<style type="text/css">
    .row .glyphicon-edit,
    .row .glyphicon-picture,
    .row .glyphicon-play-circle {
        cursor: pointer;
    }
</style>

<div class="container">
    <h2>Dicionário</h2>
    <div>
        <label>Buscar</label>
        <div>
            <div class="input-group">
                <input id="txtSearch" class="form-control" type="text" name="Search" placeholder="Pesquisa">
                <span class="input-group-btn" onclick="Search()">
                    <label class="btn btn-primary"><span class="glyphicon glyphicon-search"></span> Buscar</label>
                </span>
            </div>
        </div>
        <div id="rbtOptions" class="radio">
            <label><input type="radio" name="optionsRadios" value="General" checked="checked">Geral</label>
            <label><input type="radio" name="optionsRadios" value="Japanese">Japonês</label>
            <label><input type="radio" name="optionsRadios" value="Portuguese">Português</label>
        </div>
    </div>
    <div id="txtResponse"></div>
</div>

<div id="audioContainer" style="display: none;"></div>

