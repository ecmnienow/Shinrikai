@{
    var isLogged = Context.User.Identity.IsAuthenticated;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link href="~/Content/Images/Logo.png" rel="shortcut icon" type="image/x-icon" />
    <title>@ViewBag.Title</title>

    <link type="text/css" href="@(Url.Content("/Content/site.css"))" rel="stylesheet"/>
    <link type="text/css" href="@(Url.Content("/Content/themes/base/jquery-ui.css"))" rel="stylesheet"/>
    <link type="text/css" href="@(Url.Content("/Content/bootstrap-theme.min.css"))" rel="stylesheet"/>
    <link type="text/css" href="@(Url.Content("/Content/bootstrap.min.css"))" rel="stylesheet"/>

    <script type="text/javascript" src="@(Url.Content("/Scripts/jquery-2.1.0.min.js"))"></script>
    <script type="text/javascript" src="@(Url.Content("/Scripts/jquery-ui-1.11.4.min.js"))"></script>
    @*<script type="text/javascript" src="@(Url.Content("~/Scripts/jquery.validate.min.js"))"></script>*@
    @*<script type="text/javascript" src="@(Url.Content("~/Scripts/jquery.validate.unobtrusive.min.js"))"></script>*@
    @*<script type="text/javascript" src="@(Url.Content("/Scripts/modernizr-2.5.3.js"))"></script>*@
    <script type="text/javascript" src="@(Url.Content("/Scripts/site.js"))"></script>
    <script type="text/javascript" src="@(Url.Content("/Scripts/bootstrap.min.js"))"></script>
    <script type="text/javascript" src="@(Url.Content("/Scripts/bootstrap.dialogs/dialogs.js"))"></script>
    
    <script type="text/javascript">
        var _url_DeclareUnderstanding = "@Url.Action("DeclareUnderstanding", "Home")";
        var _url_Home = "@Url.Action("Index", "Home")";
        var _url_GetNotification = "@Url.Action("GetNotification", "Home")";
        var _url_SearchKanjiWord = "@Url.Action("SearchKanjiWord", "Transcription")";
        
        var _isAdm = @User.IsInRole("Administrator").ToString().ToLower();
        var _isTeacher = @User.IsInRole("Teacher").ToString().ToLower();
    </script>

    @RenderSection("scripts", required: false)
</head>
<body>
    <div id="header">
        <nav class="navbar navbar-default navbar-fixed-top">
            <div class="container-fluid container">
                <!-- Brand and toggle get grouped for better mobile display --> 
                <div class="navbar-header">
                    <button type="button" class="navbar-toggle collapsed" data-toggle="collapse" data-target="#bs-example-navbar-collapse-1" aria-expanded="false">
                        <span class="sr-only">Toggle navigation</span>
                        <span class="icon-bar"></span>
                        <span class="icon-bar"></span>
                        <span class="icon-bar"></span>
                    </button>
                    <a class="navbar-brand" href="@Url.Action("Index", "Home")">
                        <img alt="Brand" src="~/Content/Images/Logo.png" style="height: 24px; width: 24px; display: inline-block;">
                        Shinrikai
                    </a>
                </div>

                <!-- Collect the nav links, forms, and other content for toggling -->
                <div class="navbar-collapse collapse" id="bs-example-navbar-collapse-1">
                    @if(isLogged)
                    {
                        <ul class="nav navbar-nav">
                            <li class="dropdown">
                                <a href="#" class="dropdown-toggle" data-toggle="dropdown" role="button" aria-haspopup="true" aria-expanded="false">Aluno<span class="caret"></span></a>
                                <ul class="dropdown-menu">
                                    <li><a href="@Url.Action("Index", "Transcription")">Transcrição para hiragana</a></li>
                                    <li><a href="@Url.Action("Index", "Vocabulary")">Estudo de vocabulário</a></li>
                                    <li><a href="@Url.Action("Index", "Kanjis")">Leitura de kanjis</a></li>
                                    <li role="separator" class="divider"></li>
                                    <li><a href="@Url.Action("Index", "Grammar")">Estudo de gramática</a></li>
                                    <li><a href="@Url.Action("Index", "Text")">Leitura de textos</a></li>
                                    <li><a href="@Url.Action("Index", "Exercises")">Resolução de exercícios</a></li>
                                    <li role="separator" class="divider"></li>
                                    <li><a href="@Url.Action("Index", "Dictionary")">Dicionário</a></li>
                                </ul>
                            </li>
                            @if(User.IsInRole("Administrator") || User.IsInRole("Teacher"))
                            {
                                <li class="dropdown">
                                    <a href="#" class="dropdown-toggle" data-toggle="dropdown" role="button" aria-haspopup="true" aria-expanded="false">Professor<span class="caret"></span></a>
                                    <ul class="dropdown-menu">
                                        <li><a href="@Url.Action("Register", "Grammar")">Cadastro de gramática</a></li>
                                        <li><a href="@Url.Action("Register", "Vocabulary")">Cadastro de vocabulário</a></li>
                                        <li><a href="@Url.Action("Register", "Kanjis")">Cadastro de kanjis</a></li>
                                        <li><a href="@Url.Action("Register", "Text")">Cadastro de textos</a></li>
                                        <li><a href="@Url.Action("Register", "Exercises")">Cadastro de exercícios</a></li>
                                    </ul>
                                </li>
                            }
                            @*@if(User.IsInRole("Administrator"))
                            {
                                <li class="dropdown">
                                    <a href="#" class="dropdown-toggle" data-toggle="dropdown" role="button" aria-haspopup="true" aria-expanded="false">Administrador<span class="caret"></span></a>
                                    <ul class="dropdown-menu">
                                        <li class="disabled"><a href="#">Cadastro de assuntos</a></li>
                                        <li class="disabled"><a href="#">Relatórios de utilização</a></li>
                                        <li class="disabled"><a href="#">Controle de usuários</a></li>
                                    </ul>
                                </li>
                            }*@
                        </ul>
                    }
                    <ul class="nav navbar-nav navbar-right">
                        <li><a href="@Url.Action("About", "Home")">Sobre</a></li>
                        @if(isLogged)
                        {
                            <li><a href="@Url.Action("Logout", "Login")">Sair</a></li>
                        }
                        else
                        {
                            <li><a href="@Url.Action("Index", "Login")">Login</a></li>
                        }

                    </ul>
                </div>
                <!-- /.navbar-collapse -->
            </div>
            <!-- /.container-fluid -->
        </nav>
    </div>
    <article>
        @RenderBody()
    </article>
</body>
</html>
