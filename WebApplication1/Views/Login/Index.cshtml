@model Nienow.Shinrikai.Models.MLogin
@{
    ViewBag.Title = "Login";
}

@section scripts{
    <script type="text/javascript">
        var _url_SignUp = "@Url.Action("SignUp", "Login")";
    </script>
    
    <script type="text/javascript">
        //$(function() {
        //    $("#login-username").select();
        //});

        function Cancel() {
            $('#signupbox').hide();
            $('#loginbox').show();
            $("#signupbox .has-error").removeClass("has-error");
        }

        function ShowJLPTHelp() {
            InformationDialog("JLPT trata-se do exame de proficiência para a língua japonesa.", "Ajuda");
        }

        function SignUp() {
            var name = $("#txtName").val();
            var email = $("#txtEmail").val();
            var login = $("#txtLogin").val();
            var password = $("#txtPassword").val();
            var repeatPassword = $("#txtRepeatPassword").val();
            var sex = $("input[name='optionsSex']:checked").val();
            var birthday = $("#txtBirthday").val();
            var profession = $("#txtProfession").val();
            var otherLanguages = $("#txtOtherLanguages").val();
            var optionsJLPT = $("input[name='optionsJLPT']:checked").val();

            var valid = true;
            
            if (!name || name.length == 0) {
                $("#txtName").parent().parent().addClass("has-error");
                valid = false;
            }

            if (!validateEmail(email)) {
                $("#txtEmail").parent().parent().addClass("has-error");
                valid = false;
            }

            if (!login || login.length == 0) {
                $("#txtLogin").parent().parent().addClass("has-error");
                valid = false;
            }

            if (!password || password.length < 5) {
                AlertDialog("A senha deve ter pelo menos 5 dígitos.");
                $("#txtPassword").parent().parent().addClass("has-error");
                valid = false;
            }

            if (!repeatPassword || repeatPassword != password) {
                AlertDialog("A repetição da senha não confere.");
                $("#txtRepeatPassword").parent().parent().addClass("has-error");
                valid = false;
            }

            if (!sex) {
                $("input[name='optionsSex']").parent().parent().parent().addClass("has-error");
                valid = false;
            }

            if (!valid)
                return;

            $.ajax({
                type: "POST",
                url: _url_SignUp,
                data: {
                    Name: name,
                    Email: email,
                    Login: login,
                    Password: password,
                    RepeatPassword: repeatPassword,
                    Sex: sex,
                    Birthday: birthday,
                    Profession: profession,
                    OtherLanguages: otherLanguages,
                    JLPT: optionsJLPT
                }
            })
            .done(function (data) {
                if (data.OK === true) {
                    InformationDialog(data.Message);
                    
                    $('#signupbox').hide();
                    $('#loginbox').show();
                }
                else
                    AlertDialog(data.Message);
            });
        }
    </script>

    <style type="text/css">
        .radio label:not(:last-child) {
            margin-right: 10px;
        }

        .glyphicon-question-sign {
            cursor: pointer;
        }
    </style>
}

<div class="container">
    <!--Login-->
    <div id="loginbox" style="margin-top: 50px;" class="mainbox col-md-6 col-md-offset-3 col-sm-8 col-sm-offset-2">
        <div class="panel panel-default">
            <div class="panel-heading">
                <div class="panel-title">Login</div>
            </div>
            <div style="padding-top: 30px" class="panel-body">
                <div style="display: none" id="login-alert" class="alert alert-danger col-sm-12"></div>
                @*<form id="loginform" class="form-horizontal" role="form" method="POST" action="@Url.Action("Index", "Login")">*@
                    @using (Html.BeginForm("Index", "Login", FormMethod.Post))
                    {
                    <div style="margin-bottom: 25px" class="input-group @(Model != null && string.IsNullOrWhiteSpace(Model.Username) ? "has-error" : "")">
                        <span class="input-group-addon"><i class="glyphicon glyphicon-user"></i></span>
                        <input id="login-username" type="text" class="form-control" name="Username" placeholder="Usuário" value="@(Model != null ? Model.Username : "")">
                    </div>
                    <div style="margin-bottom: 25px" class="input-group @(Model != null && Model.Wrong ? "has-error" : "")">
                        <span class="input-group-addon"><i class="glyphicon glyphicon-lock"></i></span>
                        <input id="login-password" type="password" class="form-control" name="Password" placeholder="Senha">
                    </div>
                    <div style="margin-top: 10px" class="form-group">
                        <!-- Button -->
                        <div class="col-sm-12 controls">
                            <input class="btn btn-success" type="submit" value="Logar"/>
                            <a href="#" class="btn btn-primary" onclick="$('#loginbox').hide(); $('#signupbox').show();">Cadastrar</a>
                        </div>
                    </div>
                    }
                @*</form>*@
            </div>
        </div>
    </div>

    <!--Cadastro-->
    <div id="signupbox" style="display: none; margin-top: 50px" class="mainbox col-md-6 col-md-offset-3 col-sm-8 col-sm-offset-2">
        <div class="panel panel-default">
            <div class="panel-heading">
                <div class="panel-title">Cadastro</div>
            </div>
            <div class="panel-body">
                <div id="signupform" class="form-horizontal">
                    <div id="signupalert" style="display: none" class="alert alert-danger">
                        <p>Error:</p>
                        <span></span>
                    </div>
                    <!--Nome/Sobrenome-->
                    <div class="form-group">
                        <label for="firstname" class="col-md-4 control-label">Nome/Sobrenome</label>
                        <div class="col-md-8">
                            <input id="txtName" type="text" class="form-control" name="firstname" placeholder="Nome">
                        </div>
                    </div>
                    <!--Email-->
                    <div class="form-group">
                        <label for="email" class="col-md-4 control-label">Email</label>
                        <div class="col-md-8">
                            <input id="txtEmail" type="text" class="form-control" name="email" placeholder="Email">
                        </div>
                    </div>
                    <!--Login-->
                    <div class="form-group">
                        <label for="login" class="col-md-4 control-label">Login</label>
                        <div class="col-md-8">
                            <input id="txtLogin" type="text" class="form-control" name="login" placeholder="Login">
                        </div>
                    </div>
                    <!--Senha-->
                    <div class="form-group">
                        <label for="password" class="col-md-4 control-label">Senha</label>
                        <div class="col-md-8">
                            <input id="txtPassword" type="password" class="form-control" name="password" placeholder="Senha">
                        </div>
                    </div>
                    <!--Repetir senha-->
                    <div class="form-group">
                        <label for="repeatPassword" class="col-md-4 control-label">Repetir senha</label>
                        <div class="col-md-8">
                            <input id="txtRepeatPassword" type="password" class="form-control" name="repeatPassword" placeholder="Repetir senha">
                        </div>
                    </div>
                    <!--Sexo-->
                    <div class="form-group">
                        <label class="col-md-4 control-label">Sexo</label>
                        <div class="col-md-8 form-horizontal radio">
                            <label><input type="radio" name="optionsSex" value="male">Masculino</label>
                            <label><input type="radio" name="optionsSex" value="female">Feminino</label>
                        </div>
                    </div>
                    <!--Data de nascimento-->
                    <div class="form-group">
                        <label for="birthday" class="col-md-4 control-label">Data de nascimento</label>
                        <div class="col-md-8">
                            <input id="txtBirthday" type="text" class="form-control" name="birthday" placeholder="dd/mm/yyyy">
                        </div>
                    </div>
                    <!--Profissão-->
                    <div class="form-group">
                        <label for="profession" class="col-md-4 control-label">Profissão</label>
                        <div class="col-md-8">
                            <input id="txtProfession" type="text" class="form-control" name="profession" placeholder="Profissão">
                        </div>
                    </div>
                    <!--Outras línguas-->
                    <div class="form-group">
                        <label for="otherLanguages" class="col-md-4 control-label">Outras línguas</label>
                        <div class="col-md-8">
                            <input id="txtOtherLanguages" type="text" class="form-control" name="otherLanguages" placeholder="Outras línguas">
                        </div>
                    </div>
                    <!--JLPT-->
                    <div class="form-group">
                        <label class="col-md-4 control-label">
                            JLPT
                            <i class="glyphicon glyphicon-question-sign" onclick="ShowJLPTHelp()"></i>
                        </label>
                        <div class="col-md-8 form-horizontal radio">
                            <label><input type="radio" name="optionsJLPT" value="none">Nenhum</label>
                            <label><input type="radio" name="optionsJLPT" value="N5">N5</label>
                            <label><input type="radio" name="optionsJLPT" value="N4">N4</label>
                            <label><input type="radio" name="optionsJLPT" value="N3">N3</label>
                            <label><input type="radio" name="optionsJLPT" value="N2">N2</label>
                            <label><input type="radio" name="optionsJLPT" value="N1">N1</label>
                        </div>
                    </div>
                    

                    <div style="border-top: 1px solid #999; padding-top: 20px" class="form-group">
                        <!-- Button -->
                        <div class="col-sm-12 col-md-offset-4 controls">
                            <a href="#" class="btn btn-primary" onclick="SignUp()">Cadastrar</a>
                            <a href="#" class="btn btn-default" onclick="Cancel()">Cancelar</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
